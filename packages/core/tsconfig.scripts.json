{
  // Dev-only scripts and the tiny bin/main.ts shell are the only files permitted
  // to touch Node APIs. Kept in a separate project so that @types/node is never
  // in scope for the engine or the importable CLI body.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["scripts/**/*.ts", "src/bin/main.ts"]
}
