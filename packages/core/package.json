{
  "name": "@tui-designer/core",
  "version": "0.1.0",
  "description": "Pure-TypeScript, DOM-free engine for a terminal-UI design tool",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/metafile-*.json"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:packed": "pnpm build && tsx scripts/test-packed-cli.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "check:arch": "tsx scripts/check-arch.ts",
    "check:generated": "pnpm gen:box-table && git diff --exit-code -- src/ops/box-table.ts",
    "check:unused": "knip",
    "gen:box-table": "tsx scripts/gen-box-table.ts && biome format --write src/ops/box-table.ts",
    "lint:pkg": "pnpm build && publint && attw --pack .",
    "check:bundle": "tsx scripts/check-bundle.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@vitest/coverage-v8": "^3.2.0",
    "knip": "^6.32.3",
    "publint": "^0.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "bin": {
    "tui-designer": "./dist/bin/main.js"
  }
}
